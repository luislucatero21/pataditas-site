{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "cleanUrls": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/es/index.html", "destination": "/es/", "permanent": true },
    { "source": "/pt-br/index.html", "destination": "/pt-br/", "permanent": true },
    { "source": "/es", "destination": "/es/", "permanent": true },
    { "source": "/pt-br", "destination": "/pt-br/", "permanent": true },
    { "source": "/guide", "destination": "/guide.html", "permanent": true },
    { "source": "/privacy", "destination": "/privacy.html", "permanent": true },
    { "source": "/support", "destination": "/support.html", "permanent": true },
    { "source": "/es/guide", "destination": "/es/guide.html", "permanent": true },
    { "source": "/es/privacy", "destination": "/es/privacy.html", "permanent": true },
    { "source": "/es/support", "destination": "/es/support.html", "permanent": true },
    { "source": "/pt-br/guide", "destination": "/pt-br/guide.html", "permanent": true },
    { "source": "/pt-br/privacy", "destination": "/pt-br/privacy.html", "permanent": true },
    { "source": "/pt-br/support", "destination": "/pt-br/support.html", "permanent": true },
    { "source": "/kick-counting", "destination": "/kick-counting.html", "permanent": true },
    { "source": "/es/conteo-de-movimientos", "destination": "/es/conteo-de-movimientos.html", "permanent": true },
    { "source": "/pt-br/contagem-de-movimentos", "destination": "/pt-br/contagem-de-movimentos.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
